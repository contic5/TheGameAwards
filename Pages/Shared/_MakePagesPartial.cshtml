@model dynamic
<div>
    @{
    int pagesAdded = 0;
    if(Model.PageNumber>6)
    {
        <a asp-page="/@Model.PageName" asp-route-PageNumber="1">1</a>
    }
    @for (int i = Model.PageNumber - 5; i <= Model.PageNumber + 5; i++)
    {
        if (i > 0)
        {
            <a asp-page="/@Model.PageName" asp-route-PageNumber="@i">@i</a>
            pagesAdded += 1;

            if (pagesAdded >= 6)
            {
                break;
            }
        }
    }

    if(Model.PageNumber+5<Model.TotalPages)
    {
        <a asp-page="/@Model.PageName" asp-route-PageNumber=@Model.TotalPages>@Model.TotalPages</a>
    }
}
</div>