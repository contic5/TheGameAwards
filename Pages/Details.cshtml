@page "/Details/{GameID}"

@model TheGameAwards.Pages.DetailsModel
@{
}
<div class="text-center">
    <a asp-page="/Index">All Awards</a>
    <h1 class="display-4">@Model.Award.Name Details</h1>
    <img src=@Model.Award.BackgroundImage>
    <div class="grid">
    <div class="row">
    <div class="col border bg-subtle-primary fg-primary">Release Date</div>
    <div class="col border bg-subtle-primary fg-primary">@Model.Award.Released</div>
    </div>
    <div class="row">
    <div class="col border bg-subtle-primary fg-primary">Average Rating</div>
    <div class="col border bg-subtle-primary fg-primary">@Model.Award.Rating</div>
    </div>
    <div class="row">
    <div class="col border bg-subtle-primary fg-primary">Ratings</div>
    <div class="col border bg-subtle-primary fg-primary">@Model.Award.RatingsCount</div>
    </div>
    </div>
</div>
