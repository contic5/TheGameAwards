@page "{PageNumber:int?}"
@using AngleSharp.Common
@using Microsoft.Extensions.ObjectPool
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<div class="text-center">
    <h1 class="display-4">Welcome</h1>
    @{
        var myDataModel = new { PageName = "Index", PageNumber = Model.PageNumber};
    }
    @await Html.PartialAsync("_MakePagesPartial", myDataModel)
    <table>
    <thead>
    <tr>
    @foreach(var property in Model.awards.GetItemByIndex(0).GetType().GetProperties())
    {
        <th>@property.Name</th>
    }
    </tr>
    </thead>
    @for(int i=25*(Model.PageNumber-1);i<25*Model.PageNumber;i++)
    {
        AwardModel award=Model.awards.GetItemByIndex(i);
        <tr>
        @foreach(var property in award.GetType().GetProperties())
        {
            <td>@property.GetValue(award)</td>
        }
        </tr>
    }
    </table>
    @await Html.PartialAsync("_MakePagesPartial", myDataModel)
</div>
