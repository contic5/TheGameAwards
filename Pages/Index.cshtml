@page "{PageNumber:int?}"
@using AngleSharp.Common
@using Microsoft.Extensions.ObjectPool
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<div class="text-center">
    <h1 class="display-4">All Game Awards Nominees</h1>
    @{
        var myDataModel = new { PageName = "Index", PageNumber = Model.PageNumber, TotalPages=Model.TotalPages};
    }

    <form method="get">
    <select asp-for="SortBy" asp-items="Model.SortByItems">
    
    </select>

    <select asp-for="Direction">
    <option value="-">- to +</option>
    <option value="+">+ to -</option>
    </select>

    <button type="submit">Submit</button>
    </form>

    @await Html.PartialAsync("_MakePagesPartial", myDataModel)
    <table class="table table-striped table-hover">
    <thead>
    <tr>
    @foreach(var property in Model.awards.GetItemByIndex(0).GetType().GetProperties())
    {
        <th>@property.Name</th>
    }
    </tr>
    </thead>
    @foreach(AwardModel award in Model.awards)
    {
        <tr>
        @foreach(var property in award.GetType().GetProperties())
        {
            <td>@property.GetValue(award)</td>
        }
        </tr>
    }
    </table>
    @await Html.PartialAsync("_MakePagesPartial", myDataModel)
    <p>All data was obtained from Wikipedia by using Requests with proper User-Agents.</p>
</div>
