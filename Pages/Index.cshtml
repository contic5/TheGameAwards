@page "{PageNumber:int?}"
@using AngleSharp.Common
@using Microsoft.Extensions.ObjectPool
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<div class="text-center">
    <h1 class="display-4">All Game Awards Nominees</h1>
    @{
        var myDataModel = new { PageName = "Index", PageNumber = Model.PageNumber, TotalPages=Model.TotalPages};
    }

    <form method="get">
    <div>
    <label for="TargetYear">Target Year</label>
    <input id="TargetYear" asp-for="TargetYear" />
    </div>

    <div>
    <label for="TargetCategory">Target Category</label>
    <input list="allcategories" id="TargetCategory asp-for="TargetCategory" />
    <datalist id="allcategories">
    <option value="">Any</option>
    @foreach(var category in Model.AllCategories)
    {
        <option value=@category>@category</option>        
    }
    </datalist>
    </div>

    <div>
    <label for="TargetCompany">Target Company</label>
    <input list="allcompanies" id="TargetCompany" asp-for="TargetCompany" />
    <datalist id="allcompanies">
    <option value="">Any</option>
    @foreach(var company in Model.AllCompanies)
    {
        <option value=@company>@company</option>        
    }
    </datalist>
    </div>

    <div>
    <label for="TargetGenre">Target Genre</label>
    <input list="allgenres" id="TargetGenre" asp-for="TargetGenre" />
    <datalist id="allgenres">
    <option value="">Any</option>
    @foreach(var genre in Model.AllGenres)
    {
        <option value=@genre>@genre</option>        
    }
    </datalist>
    </div>

    <select asp-for="SortBy" asp-items="Model.SortByItems">
    
    </select>

    <select asp-for="Direction">
    <option value="-">- to +</option>
    <option value="+">+ to -</option>
    </select>

    <button type="submit">Submit</button>
    </form>

    @await Html.PartialAsync("_MakePagesPartial", myDataModel)
    <table class="table table-striped table-hover">
    <thead>
    <tr>
    @foreach(var property in Model.Awards.GetItemByIndex(0).GetType().GetProperties())
    {
        <th>@property.Name</th>
    }
    <th>Details</th>
    </tr>
    </thead>
    @foreach(AwardModel award in Model.Awards)
    {
        <tr>
        @foreach(var property in award.GetType().GetProperties())
        {
            <td>@property.GetValue(award)</td>
        }
        <td><a asp-page="/Details" asp-route-GameID=@award.ID>Details</a></td>
        </tr>
    }
    </table>
    @await Html.PartialAsync("_MakePagesPartial", myDataModel)
    <p>All data was obtained from Wikipedia by using Requests with proper User-Agents.</p>
</div>
